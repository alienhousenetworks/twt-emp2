{
  "doctype": "DocType",
  "name": "Agency EOD Report",
  "module": "Agency Workforce OS",
  "autoname": "hash",
  "title_field": "employee",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "employee",
      "label": "Employee",
      "fieldtype": "Link",
      "options": "Employee",
      "reqd": 1,
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "report_date",
      "label": "Report Date",
      "fieldtype": "Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "completed_work",
      "label": "Work Completed",
      "fieldtype": "Long Text",
      "reqd": 1
    },
    {
      "fieldname": "pending_work",
      "label": "Work Pending",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "blockers",
      "label": "Blockers and Risks",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "next_day_plan",
      "label": "Next Day Plan",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "help_needed",
      "label": "Help Needed",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "audience",
      "label": "Audience",
      "fieldtype": "Select",
      "options": "Private\nTeam\nDepartment",
      "default": "Team",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nSubmitted\nReviewed\nReturned",
      "default": "Draft",
      "reqd": 1,
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "submitted_at",
      "label": "Submitted At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "reviewed_by",
      "label": "Reviewed By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "reviewed_at",
      "label": "Reviewed At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "review_notes",
      "label": "Manager Review Notes",
      "fieldtype": "Small Text"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "HR Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    },
    {
      "role": "Agency Employee",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    }
  ]
}