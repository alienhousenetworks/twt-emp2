      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    },
    {
      "role": "Sales Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    },
    {
      "role": "Sales User",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    },
    {
      "role": "HR User",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    }
  ]
}