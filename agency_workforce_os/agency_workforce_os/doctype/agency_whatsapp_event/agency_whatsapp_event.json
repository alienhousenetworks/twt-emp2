{
  "doctype": "DocType",
  "name": "Agency WhatsApp Event",
  "module": "Agency Workforce OS",
  "autoname": "hash",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "event_key",
      "label": "Idempotency Key",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "provider_message_id",
      "label": "Provider Message ID",
      "fieldtype": "Data",
      "in_list_view": 1
    },
    {
      "fieldname": "event_type",
      "label": "Event Type",
      "fieldtype": "Select",
      "options": "message\nstatus\nother",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "payload_json",
      "label": "Verified Payload",
      "fieldtype": "Code",
      "options": "JSON",
      "reqd": 1
    },
    {
      "fieldname": "processing_status",
      "label": "Processing Status",
      "fieldtype": "Select",
      "options": "Received\nProcessing\nProcessed\nFailed",
      "default": "Received",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "received_at",
      "label": "Received At",
      "fieldtype": "Datetime",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "last_error",
      "label": "Last Error",
      "fieldtype": "Small Text"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    }
  ]
}